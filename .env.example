NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Leave blank for repository assets without paid Cloud Storage.
# If Storage is enabled later, use its actual bucket name from Firebase Console.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Server-only. Local development can use `gcloud auth application-default login`
# instead. On Vercel, configure both service-account fields below, or use a
# workload identity with Application Default Credentials.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Production on Vercel can instead use the configured keyless workload identity.
# Keep these unset for local development and preview environments.
FIREBASE_USE_VERCEL_OIDC=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# 32 random bytes encoded as base64, for the application-managed TOTP secrets.
FIREBASE_MFA_ENCRYPTION_KEY=

# Configure GitHub OAuth credentials only in Firebase Authentication.
# Firebase handles the code exchange; Vercel does not need the OAuth secret.
# GitHub OAuth app callback URL: APP_URL/auth/callback.

# hCaptcha is verified by the application before Firebase login, password
# recovery, and contact submission. It is not delegated to Firebase Auth.
NEXT_PUBLIC_CAPTCHA_PROVIDER=hcaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=https://ahmedaziz-portfolio.vercel.app
APP_URL=https://ahmedaziz-portfolio.vercel.app
# Local loopback origins are added automatically outside production.
ALLOWED_ORIGINS=https://ahmedaziz-portfolio.vercel.app

REQUIRE_ADMIN_MFA=true
ADMIN_MFA_REMEMBER_DAYS=10

# Generate three different values, each with at least 32 random bytes. Never
# reuse an application secret or Firebase private key, and never expose these with a
# NEXT_PUBLIC_ prefix. ADMIN_DEVICE_HMAC_SECRET has no fallback.
RATE_LIMIT_HMAC_SECRET=
PRIVACY_HMAC_SECRET=
ADMIN_DEVICE_HMAC_SECRET=

# Contact notifications are attempted only after the message is persisted.
# Failed delivery is retried manually from admin; no scheduler is deployed.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=

NEXT_PUBLIC_GITHUB_USERNAME=ahmedazizmhiri
NEXT_PUBLIC_GITHUB_PROFILE_URL=
NEXT_PUBLIC_LINKEDIN_PROFILE_URL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# `npm run test:firebase` uses local emulators and a demo- project ID. It never
# needs production credentials. See docs/FIREBASE_MIGRATION.md.

# Optional authenticated Playwright lifecycle project. The storage-state file
# must contain an MFA-verified admin session for the same non-production project.
PRODUCTION_FIREBASE_PROJECT_ID=portfolio-cb36f
E2E_FIREBASE_PROJECT_ID=
E2E_FIREBASE_API_KEY=
E2E_FIREBASE_STORAGE_BUCKET=
E2E_ADMIN_STORAGE_STATE=
ALLOW_E2E_DATABASE_MUTATIONS=false
